model User {
  id    Int    @id @default(autoincrement())
  name  String
  votes Vote[]
}

model Post {
  id    Int    @id @default(autoincrement())
  title String
  body  String
  score Int    @default(0)
  votes Vote[]
}

model Vote {
  id     Int @id @default(autoincrement())
  userId Int
  postId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}